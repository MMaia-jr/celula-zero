# Supabase local defaults. These values are public client configuration, not
# privileged credentials. Obtain the exact local values with `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Public application origin used for OAuth redirects. Set the production HTTPS
# URL in hosted environments; localhost remains valid for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel AI Gateway — server-side only, never exposed to client.
# The Genesis adapter fixes the OpenAI-compatible base URL to this origin.
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=replace-with-gateway-key

# Dogfood helpers (optional, for CLI tools)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=replace-with-local-anon-key
# SUPABASE_ACCESS_TOKEN=replace-with-user-access-token
