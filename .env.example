# Supabase local defaults. These values are public client configuration, not
# privileged credentials. Obtain the exact local values with `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Used only to form local authentication redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel AI Gateway — server-side only, never exposed to client
AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT/YOUR_GATEWAY
AI_GATEWAY_API_KEY=replace-with-gateway-key

# Dogfood helpers (optional, for CLI tools)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=replace-with-local-anon-key
# SUPABASE_ACCESS_TOKEN=replace-with-user-access-token
