# Supabase local defaults. These values are public client configuration, not
# privileged credentials. Obtain the exact local values with `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Used only to form local authentication redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
