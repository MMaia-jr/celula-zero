diff --git a/models/cz/src/index.ts b/models/cz/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3250dba685cf1f2e7012067935913049c5c2afd9
--- /dev/null
+++ b/models/cz/src/index.ts
@@ -0,0 +1,166 @@
+import type {
+  Class,
+  Doc,
+  Domain,
+  Permission,
+  Ref,
+  Role,
+  RolesAssignment,
+  SpaceType,
+  TypedSpace
+} from '@hcengineering/core'
+import core from '@hcengineering/core'
+import cz, {
+  czId,
+  type CZCellSpace,
+  type CZHumanDirection,
+  type CZInterpretation,
+  type CZOriginalRecord
+} from '@hcengineering/cz'
+import { Model, Mixin, Prop, TypeRef, TypeString, type Builder } from '@hcengineering/model'
+import modelCore, { TDoc, TTypedSpace } from '@hcengineering/model-core'
+import { getEmbeddedLabel } from '@hcengineering/platform'
+import { getRoleAttributeProps } from '@hcengineering/setting'
+
+export { czId }
+export { default } from '@hcengineering/cz'
+
+export const DOMAIN_CZ = 'cz' as Domain
+
+@Model(cz.class.CellSpace, modelCore.class.TypedSpace)
+export class TCZCellSpace extends TTypedSpace implements CZCellSpace {
+  @Prop(TypeRef(core.class.SpaceType), getEmbeddedLabel('Cell type'))
+  declare type: Ref<SpaceType>
+}
+
+@Model(cz.class.OriginalRecord, modelCore.class.Doc, DOMAIN_CZ)
+export class TCZOriginalRecord extends TDoc implements CZOriginalRecord {
+  @Prop(TypeRef(cz.class.CellSpace), getEmbeddedLabel('Cell'))
+  declare space: Ref<CZCellSpace>
+
+  @Prop(TypeString(), getEmbeddedLabel('Content'))
+  content!: string
+}
+
+@Model(cz.class.Interpretation, modelCore.class.Doc, DOMAIN_CZ)
+export class TCZInterpretation extends TDoc implements CZInterpretation {
+  @Prop(TypeRef(cz.class.CellSpace), getEmbeddedLabel('Cell'))
+  declare space: Ref<CZCellSpace>
+
+  @Prop(TypeRef(cz.class.OriginalRecord), getEmbeddedLabel('Original record'))
+  originalRecord!: Ref<CZOriginalRecord>
+
+  @Prop(TypeString(), getEmbeddedLabel('Content'))
+  content!: string
+}
+
+@Model(cz.class.HumanDirection, modelCore.class.Doc, DOMAIN_CZ)
+export class TCZHumanDirection extends TDoc implements CZHumanDirection {
+  @Prop(TypeRef(cz.class.CellSpace), getEmbeddedLabel('Cell'))
+  declare space: Ref<CZCellSpace>
+
+  @Prop(TypeRef(cz.class.OriginalRecord), getEmbeddedLabel('Source record'))
+  sourceRecord!: Ref<CZOriginalRecord>
+
+  @Prop(TypeRef(cz.class.Interpretation), getEmbeddedLabel('Interpretation'))
+  interpretation?: Ref<CZInterpretation>
+
+  @Prop(TypeString(), getEmbeddedLabel('Content'))
+  content!: string
+}
+
+@Mixin(cz.mixin.CellSpaceTypeData, cz.class.CellSpace)
+export class TCZCellSpaceTypeData extends TCZCellSpace implements RolesAssignment {
+  [key: Ref<Role>]: import('@hcengineering/core').AccountUuid[] | undefined
+}
+
+const permissionDefinitions: Array<{
+  id: Ref<Permission>
+  txClass: Ref<Class<any>>
+  objectClass: Ref<Class<Doc>>
+  label: string
+}> = [
+  { id: cz.permission.CreateOriginalRecord, txClass: core.class.TxCreateDoc, objectClass: cz.class.OriginalRecord, label: 'Create Original Record' },
+  { id: cz.permission.UpdateOriginalRecord, txClass: core.class.TxUpdateDoc, objectClass: cz.class.OriginalRecord, label: 'Update Original Record' },
+  { id: cz.permission.RemoveOriginalRecord, txClass: core.class.TxRemoveDoc, objectClass: cz.class.OriginalRecord, label: 'Remove Original Record' },
+  { id: cz.permission.CreateInterpretation, txClass: core.class.TxCreateDoc, objectClass: cz.class.Interpretation, label: 'Create Interpretation' },
+  { id: cz.permission.UpdateInterpretation, txClass: core.class.TxUpdateDoc, objectClass: cz.class.Interpretation, label: 'Update Interpretation' },
+  { id: cz.permission.RemoveInterpretation, txClass: core.class.TxRemoveDoc, objectClass: cz.class.Interpretation, label: 'Remove Interpretation' },
+  { id: cz.permission.CreateHumanDirection, txClass: core.class.TxCreateDoc, objectClass: cz.class.HumanDirection, label: 'Create Human Direction' },
+  { id: cz.permission.UpdateHumanDirection, txClass: core.class.TxUpdateDoc, objectClass: cz.class.HumanDirection, label: 'Update Human Direction' },
+  { id: cz.permission.RemoveHumanDirection, txClass: core.class.TxRemoveDoc, objectClass: cz.class.HumanDirection, label: 'Remove Human Direction' }
+]
+
+export const roles: Array<{ _id: Ref<Role>, name: string, permissions: Ref<Permission>[] }> = [
+  { _id: cz.role.HumanParticipant, name: 'HUMAN_PARTICIPANT', permissions: [cz.permission.CreateOriginalRecord] },
+  {
+    _id: cz.role.HumanSteward,
+    name: 'HUMAN_STEWARD',
+    permissions: [cz.permission.CreateOriginalRecord, cz.permission.CreateInterpretation, cz.permission.CreateHumanDirection]
+  },
+  { _id: cz.role.AiParticipant, name: 'AI_PARTICIPANT', permissions: [cz.permission.CreateInterpretation] }
+]
+
+export function createModel (builder: Builder): void {
+  for (const role of roles) {
+    const { label, roleType } = getRoleAttributeProps(role.name)
+    Prop(roleType, label)(TCZCellSpaceTypeData.prototype, role._id)
+  }
+
+  builder.createModel(TCZCellSpace, TCZOriginalRecord, TCZInterpretation, TCZHumanDirection, TCZCellSpaceTypeData)
+
+  for (const definition of permissionDefinitions) {
+    builder.createDoc(
+      core.class.Permission,
+      core.space.Model,
+      {
+        label: getEmbeddedLabel(definition.label),
+        scope: 'space',
+        txClass: definition.txClass,
+        objectClass: definition.objectClass,
+        forbid: false
+      },
+      definition.id
+    )
+  }
+
+  builder.createDoc(
+    core.class.SpaceTypeDescriptor,
+    core.space.Model,
+    {
+      name: getEmbeddedLabel('Célula Zero Cell'),
+      description: getEmbeddedLabel('Restricted Célula Zero cell'),
+      icon: core.icon.TypeRecord,
+      baseClass: cz.class.CellSpace,
+      availablePermissions: permissionDefinitions.map(({ id }) => id)
+    },
+    cz.descriptor.Cell
+  )
+
+  builder.createDoc(
+    core.class.SpaceType,
+    core.space.Model,
+    {
+      name: 'Célula Zero Cell',
+      descriptor: cz.descriptor.Cell,
+      roles: roles.length,
+      targetClass: cz.mixin.CellSpaceTypeData
+    },
+    cz.spaceType.Cell
+  )
+
+  for (const role of roles) {
+    builder.createDoc(
+      core.class.Role,
+      core.space.Model,
+      {
+        attachedTo: cz.spaceType.Cell,
+        attachedToClass: core.class.SpaceType,
+        collection: 'roles',
+        name: role.name,
+        permissions: role.permissions
+      },
+      role._id
+    )
+  }
+}
