@@ -0,0 +1,67 @@
+import type {
+  Class,
+  Doc,
+  Mixin,
+  Permission,
+  Ref,
+  Role,
+  SpaceType,
+  SpaceTypeDescriptor,
+  TypedSpace
+} from '@hcengineering/core'
+import { type Plugin, plugin } from '@hcengineering/platform'
+
+export interface CZCellSpace extends TypedSpace {
+  type: Ref<SpaceType>
+}
+
+export interface CZOriginalRecord extends Doc<CZCellSpace> {
+  content: string
+}
+
+export interface CZInterpretation extends Doc<CZCellSpace> {
+  originalRecord: Ref<CZOriginalRecord>
+  content: string
+}
+
+export interface CZHumanDirection extends Doc<CZCellSpace> {
+  sourceRecord: Ref<CZOriginalRecord>
+  interpretation?: Ref<CZInterpretation>
+  content: string
+}
+
+export const czId = 'cz' as Plugin
+
+export default plugin(czId, {
+  class: {
+    CellSpace: '' as Ref<Class<CZCellSpace>>,
+    OriginalRecord: '' as Ref<Class<CZOriginalRecord>>,
+    Interpretation: '' as Ref<Class<CZInterpretation>>,
+    HumanDirection: '' as Ref<Class<CZHumanDirection>>
+  },
+  mixin: {
+    CellSpaceTypeData: '' as Ref<Mixin<CZCellSpace>>
+  },
+  permission: {
+    CreateOriginalRecord: '' as Ref<Permission>,
+    UpdateOriginalRecord: '' as Ref<Permission>,
+    RemoveOriginalRecord: '' as Ref<Permission>,
+    CreateInterpretation: '' as Ref<Permission>,
+    UpdateInterpretation: '' as Ref<Permission>,
+    RemoveInterpretation: '' as Ref<Permission>,
+    CreateHumanDirection: '' as Ref<Permission>,
+    UpdateHumanDirection: '' as Ref<Permission>,
+    RemoveHumanDirection: '' as Ref<Permission>
+  },
+  role: {
+    HumanParticipant: '' as Ref<Role>,
+    HumanSteward: '' as Ref<Role>,
+    AiParticipant: '' as Ref<Role>
+  },
+  spaceType: {
+    Cell: '' as Ref<SpaceType>
+  },
+  descriptor: {
+    Cell: '' as Ref<SpaceTypeDescriptor>
+  }
+})
