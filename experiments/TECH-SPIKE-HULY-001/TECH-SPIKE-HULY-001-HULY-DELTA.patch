index 0000000000000000000000000000000000000000..bcd7a762a0c3c2329c6398a5bc1cdfc46c5008ee
--- /dev/null
+++ b/plugins/intent-resources/src/components/ContributionCollection.svelte
@@ -0,0 +1,121 @@
+<!-- Copyright © 2026 Celula Zero. Licensed under EPL-2.0. -->
+<script lang="ts">
+  import { AccountBox } from '@hcengineering/contact-resources'
+  import { type PersonId, SortingOrder } from '@hcengineering/core'
+  import intent, { type Contribution, type Intent } from '@hcengineering/intent'
+  import { createQuery, getClient } from '@hcengineering/presentation'
+  import { Button, EditBox, Label } from '@hcengineering/ui'
+  import { PersonIdPresenter, TimestampPresenter } from '@hcengineering/view-resources'
+
+  export let object: Intent
+  export let readonly: boolean = false
+
+  const client = getClient()
+  const query = createQuery()
+
+  let contributions: Contribution[] = []
+  let author: PersonId | null = null
+  let contribution = ''
+
+  $: query.query(
+    intent.class.Contribution,
+    { attachedTo: object._id },
+    (result) => {
+      contributions = result
+    },
+    { sort: { createdOn: SortingOrder.Ascending } }
+  )
+
+  async function addContribution (): Promise<void> {
+    if (readonly || author === null || contribution.trim().length === 0) return
+
+    await client.addCollection(
+      intent.class.Contribution,
+      object.space,
+      object._id,
+      object._class,
+      'contributions',
+      {
+        author,
+        contribution: contribution.trim()
+      }
+    )
+    contribution = ''
+  }
+</script>
+
+<section class="contributions">
+  <h3><Label label={intent.string.Contributions} /></h3>
+
+  {#if contributions.length === 0}
+    <div class="empty"><Label label={intent.string.NoContributions} /></div>
+  {:else}
+    {#each contributions as item (item._id)}
+      <article class="contribution">
+        <div class="metadata">
+          <PersonIdPresenter value={item.author} withPadding={false} avatarSize={'tiny'} />
+          <TimestampPresenter value={item.createdOn} />
+        </div>
+        <div class="content">{item.contribution}</div>
+      </article>
+    {/each}
+  {/if}
+
+  <div class="composer">
+    <AccountBox
+      label={intent.string.Author}
+      value={author}
+      kind={'regular'}
+      width={'100%'}
+      {readonly}
+      on:change={(event) => {
+        author = event.detail
+      }}
+    />
+    <EditBox
+      label={intent.string.Contribution}
+      placeholder={intent.string.ContributionPlaceholder}
+      bind:value={contribution}
+      format={'text-multiline'}
+      disabled={readonly}
+      fullSize
+    />
+    <Button
+      label={intent.string.AddContribution}
+      kind={'primary'}
+      disabled={readonly || author === null || contribution.trim().length === 0}
+      on:click={addContribution}
+    />
+  </div>
+</section>
+
+<style lang="scss">
+  .contributions,
+  .composer {
+    display: flex;
+    flex-direction: column;
+    gap: 0.75rem;
+  }
+
+  .contribution {
+    padding: 0.75rem;
+    border: 1px solid var(--theme-divider-color);
+    border-radius: 0.5rem;
+  }
+
+  .metadata {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.5rem;
+    margin-bottom: 0.5rem;
+  }
+
+  .content {
+    white-space: pre-wrap;
+  }
+
+  .empty {
+    color: var(--theme-dark-color);
+  }
+</style>
