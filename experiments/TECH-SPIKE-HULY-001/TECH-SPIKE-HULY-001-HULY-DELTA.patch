@@ -0,0 +1,62 @@
+<!-- Copyright © 2026 Celula Zero. Licensed under EPL-2.0. -->
+<script lang="ts">
+  import { AccountBox } from '@hcengineering/contact-resources'
+  import core, { type Data, type PersonId, generateId } from '@hcengineering/core'
+  import intent, { type Intent, IntentState } from '@hcengineering/intent'
+  import { Card, getClient } from '@hcengineering/presentation'
+  import { EditBox, Grid } from '@hcengineering/ui'
+  import { createEventDispatcher } from 'svelte'
+
+  const client = getClient()
+  const dispatch = createEventDispatcher()
+  const id = generateId<Intent>()
+
+  let originator: PersonId | null = null
+  let statement = ''
+
+  export function canClose (): boolean {
+    return statement === ''
+  }
+
+  async function createIntent (): Promise<void> {
+    if (originator === null || statement.trim().length === 0) return
+
+    const data: Data<Intent> = {
+      originator,
+      statement: statement.trim(),
+      state: IntentState.Open,
+      contributions: 0
+    }
+
+    const intentId = await client.createDoc(intent.class.Intent, core.space.Workspace, data, id)
+    dispatch('close', intentId)
+  }
+</script>
+
+<Card
+  label={intent.string.CreateIntent}
+  okAction={createIntent}
+  canSave={originator !== null && statement.trim().length > 0}
+  on:close={() => dispatch('close')}
+>
+  <Grid column={1} rowGap={1.5}>
+    <AccountBox
+      label={intent.string.Originator}
+      value={originator}
+      kind={'regular'}
+      width={'100%'}
+      on:change={(event) => {
+        originator = event.detail
+      }}
+    />
+    <EditBox
+      label={intent.string.Statement}
+      placeholder={intent.string.Statement}
+      bind:value={statement}
+      format={'text-multiline'}
+      autoFocus
+      required
+      fullSize
+    />
+  </Grid>
+</Card>
diff --git a/plugins/intent-resources/src/components/EditIntentPanel.svelte b/plugins/intent-resources/src/components/EditIntentPanel.svelte
new file mode 100644
index 0000000000000000000000000000000000000000..a305fad35d5758b6b42a8368fc77d734a6508f13
--- /dev/null
+++ b/plugins/intent-resources/src/components/EditIntentPanel.svelte
@@ -0,0 +1,150 @@
+<!-- Copyright © 2026 Celula Zero. Licensed under EPL-2.0. -->
+<script lang="ts">
+  import { AccountBox } from '@hcengineering/contact-resources'
+  import type { PersonId, Ref } from '@hcengineering/core'
+  import intent, { type Intent, IntentState } from '@hcengineering/intent'
+  import { Panel } from '@hcengineering/panel'
+  import { createQuery, getClient } from '@hcengineering/presentation'
+  import { Button, EditBox, Label } from '@hcengineering/ui'
+  import { createEventDispatcher } from 'svelte'
+  import ContributionCollection from './ContributionCollection.svelte'
+  import IntentStatePresenter from './IntentStatePresenter.svelte'
+
+  export let _id: Ref<Intent>
+  export let embedded: boolean = false
+  export let readonly: boolean = false
+
+  const client = getClient()
+  const query = createQuery()
+  const dispatch = createEventDispatcher()
+
+  let object: Intent | undefined
+  $: query.query(intent.class.Intent, { _id }, (result) => {
+    object = result[0]
+  })
+
+  async function update (patch: Partial<Intent>): Promise<void> {
+    if (object === undefined || readonly) return
+    await client.updateDoc(object._class, object.space, object._id, patch)
+  }
+
+  async function updateOriginator (event: CustomEvent<PersonId | null>): Promise<void> {
+    if (event.detail === null) return
+    await update({ originator: event.detail })
+  }
+
+  async function advanceState (): Promise<void> {
+    if (object === undefined) return
+    if (object.state === IntentState.Open) {
+      await update({ state: IntentState.InProgress })
+    } else if (object.state === IntentState.InProgress) {
+      await update({ state: IntentState.Completed })
+    }
+  }
+</script>
+
+{#if object !== undefined}
+  <Panel
+    isHeader={false}
+    isSub={false}
+    isAside={true}
+    {embedded}
+    {object}
+    withoutInput={true}
+    on:close={() => dispatch('close')}
+  >
+    <svelte:fragment slot="title">
+      <div class="title">{object.statement}</div>
+    </svelte:fragment>
+
+    <div class="body">
+      <div class="field">
+        <Label label={intent.string.Originator} />
+        <AccountBox
+          label={intent.string.Originator}
+          value={object.originator}
+          readonly={readonly}
+          kind={'regular'}
+          width={'100%'}
+          on:change={updateOriginator}
+        />
+      </div>
+
+      <EditBox
+        label={intent.string.Statement}
+        bind:value={object.statement}
+        format={'text-multiline'}
+        disabled={readonly}
+        fullSize
+        on:change={() => update({ statement: object.statement })}
+      />
+
+      <div class="field">
+        <Label label={intent.string.State} />
+        <div class="state">
+          <IntentStatePresenter value={object.state} />
+          {#if !readonly && object.state === IntentState.Open}
+            <Button label={intent.string.AdvanceToInProgress} on:click={advanceState} />
+          {:else if !readonly && object.state === IntentState.InProgress}
+            <Button label={intent.string.AdvanceToCompleted} on:click={advanceState} />
+          {/if}
+        </div>
+      </div>
+
+      <EditBox
+        label={intent.string.EvidenceReference}
+        bind:value={object.evidenceReference}
+        disabled={readonly}
+        fullSize
+        on:change={() => update({ evidenceReference: object.evidenceReference })}
+      />
+
+      <EditBox
+        label={intent.string.Result}
+        bind:value={object.result}
+        format={'text-multiline'}
+        disabled={readonly}
+        fullSize
+        on:change={() => update({ result: object.result })}
+      />
+
+      <ContributionCollection {object} {readonly} />
+
+      <p class="limitation">
+        State transitions are constrained by this experimental UI only; no server-side lifecycle enforcement is provided.
+        ActivityDoc supplies observable activity/history, not evidence, verification, strong provenance, or immutability.
+      </p>
+    </div>
+  </Panel>
+{/if}
+
+<style lang="scss">
+  .title {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+  }
+
+  .body,
+  .field {
+    display: flex;
+    flex-direction: column;
+    gap: 0.75rem;
+  }
+
+  .body {
+    padding: 1rem;
+  }
+
+  .state {
+    display: flex;
+    align-items: center;
+    gap: 0.75rem;
+  }
+
+  .limitation {
+    color: var(--theme-dark-color);
+    font-size: 0.75rem;
+    line-height: 1.4;
+  }
+</style>
