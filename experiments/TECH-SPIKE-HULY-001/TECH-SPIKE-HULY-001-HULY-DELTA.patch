+{
+  "name": "@hcengineering/intent-assets",
+  "version": "0.7.0",
+  "main": "./lib/index.js",
+  "types": "./types/index.d.ts",
+  "files": [
+    "lib",
+    "types",
+    "src",
+    "assets",
+    "lang"
+  ],
+  "author": "Celula Zero",
+  "template": "@hcengineering/assets-package",
+  "license": "EPL-2.0",
+  "scripts": {
+    "build": "compile",
+    "build:docs": "",
+    "build:watch": "compile",
+    "format": "format src",
+    "test": "jest --passWithNoTests --silent",
+    "_phase:build": "compile transpile src",
+    "_phase:format": "format src",
+    "_phase:test": "jest --passWithNoTests --silent",
+    "_phase:validate": "compile validate"
+  },
+  "devDependencies": {
+    "@hcengineering/platform-rig": "workspace:^0.7.21",
+    "@types/jest": "^29.5.5",
