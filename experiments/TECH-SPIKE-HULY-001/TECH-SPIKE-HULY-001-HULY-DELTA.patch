+// Copyright © 2026 Celula Zero
+// Licensed under the Eclipse Public License, Version 2.0.
+
+import type { AttachedDoc, Class, Doc, PersonId, Ref } from '@hcengineering/core'
+import { type Asset, type IntlString, type Plugin, plugin } from '@hcengineering/platform'
+import type { AnyComponent } from '@hcengineering/ui'
+import type { Viewlet } from '@hcengineering/view'
+
+/** Experimental lifecycle used by TECH-SPIKE-HULY-001. */
+export enum IntentState {
+  Open = 'open',
+  InProgress = 'in_progress',
+  Completed = 'completed'
+}
+
+/** Minimal root domain object for the spike. */
+export interface Intent extends Doc {
+  /** Explicit domain identity. It is not inferred from createdBy. */
+  originator: PersonId
+  statement: string
+  state: IntentState
+  evidenceReference?: string
+  result?: string
+  contributions?: number
+}
+
+/** A later, independently authored contribution attached to an Intent. */
+export interface Contribution extends AttachedDoc {
+  author: PersonId
+  contribution: string
+}
+
+export const intentId = 'intent' as Plugin
+
+const intent = plugin(intentId, {
+  class: {
+    Intent: '' as Ref<Class<Intent>>,
+    Contribution: '' as Ref<Class<Contribution>>
+  },
+  icon: {
+    Intent: '' as Asset,
+    Contribution: '' as Asset
+  },
+  app: {
+    Intent: '' as Ref<Doc>
+  },
+  string: {
+    Application: '' as IntlString,
+    ConfigLabel: '' as IntlString,
+    ConfigDescription: '' as IntlString,
+    Intent: '' as IntlString,
+    Intents: '' as IntlString,
+    CreateIntent: '' as IntlString,
+    Originator: '' as IntlString,
+    Statement: '' as IntlString,
+    State: '' as IntlString,
+    Open: '' as IntlString,
+    InProgress: '' as IntlString,
+    Completed: '' as IntlString,
+    AdvanceToInProgress: '' as IntlString,
+    AdvanceToCompleted: '' as IntlString,
+    EvidenceReference: '' as IntlString,
+    Result: '' as IntlString,
+    Contribution: '' as IntlString,
+    Contributions: '' as IntlString,
+    Author: '' as IntlString,
+    AddContribution: '' as IntlString,
+    ContributionPlaceholder: '' as IntlString,
+    NoContributions: '' as IntlString
+  },
+  component: {
+    CreateIntent: '' as AnyComponent,
+    EditIntentPanel: '' as AnyComponent,
+    IntentPresenter: '' as AnyComponent,
+    IntentStatePresenter: '' as AnyComponent,
+    ContributionCollection: '' as AnyComponent
+  },
+  viewlet: {
+    TableIntent: '' as Ref<Viewlet>
+  }
+})
+
+export default intent
