diff --git a/models/intent/src/index.ts b/models/intent/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b65b07723c20e17dd2d585ba2904ae661116c475
--- /dev/null
+++ b/models/intent/src/index.ts
@@ -0,0 +1,131 @@
+// Copyright © 2026 Celula Zero
+// Licensed under the Eclipse Public License, Version 2.0.
+
+import activity from '@hcengineering/activity'
+import { AccountRole, type Domain, IndexKind } from '@hcengineering/core'
+import intent, { type Contribution, type Intent, IntentState, intentId } from '@hcengineering/intent'
+import {
+  type Builder,
+  Collection,
+  Index,
+  Model,
+  Prop,
+  TypePersonId,
+  TypeString,
+  UX
+} from '@hcengineering/model'
+import core, { TAttachedDoc, TDoc } from '@hcengineering/model-core'
+import view, { type Viewlet } from '@hcengineering/model-view'
+import workbench from '@hcengineering/model-workbench'
+
+export { intentId } from '@hcengineering/intent'
+export { default } from '@hcengineering/intent'
+
+export const DOMAIN_INTENT = 'intent' as Domain
+
+@Model(intent.class.Intent, core.class.Doc, DOMAIN_INTENT)
+@UX(intent.string.Intent, intent.icon.Intent, 'INT', 'statement', undefined, intent.string.Intents)
+export class TIntent extends TDoc implements Intent {
+  @Prop(TypePersonId(), intent.string.Originator)
+    originator!: Intent['originator']
+
+  @Prop(TypeString(), intent.string.Statement)
+  @Index(IndexKind.FullText)
+    statement!: string
+
+  @Prop(TypeString(), intent.string.State)
+    state!: IntentState
+
+  @Prop(TypeString(), intent.string.EvidenceReference)
+  @Index(IndexKind.FullText)
+    evidenceReference?: string
+
+  @Prop(TypeString(), intent.string.Result)
+  @Index(IndexKind.FullText)
+    result?: string
+
+  @Prop(Collection(intent.class.Contribution), intent.string.Contributions)
+    contributions?: number
+}
+
+@Model(intent.class.Contribution, core.class.AttachedDoc, DOMAIN_INTENT)
+@UX(intent.string.Contribution, intent.icon.Contribution)
+export class TContribution extends TAttachedDoc implements Contribution {
+  @Prop(TypePersonId(), intent.string.Author)
+    author!: Contribution['author']
+
+  @Prop(TypeString(), intent.string.Contribution)
+  @Index(IndexKind.FullText)
+    contribution!: string
+}
+
+export function createModel (builder: Builder): void {
+  builder.createModel(TIntent, TContribution)
+
+  builder.createDoc(
+    workbench.class.Application,
+    core.space.Model,
+    {
+      label: intent.string.Application,
+      icon: intent.icon.Intent,
+      alias: intentId,
+      accessLevel: AccountRole.User,
+      hidden: false,
+      navigatorModel: {
+        spaces: [],
+        specials: [
+          {
+            id: 'intents',
+            label: intent.string.Intents,
+            icon: intent.icon.Intent,
+            component: workbench.component.SpecialView,
+            componentProps: {
+              _class: intent.class.Intent,
+              icon: intent.icon.Intent,
+              label: intent.string.Intents,
+              createLabel: intent.string.CreateIntent,
+              createComponent: intent.component.CreateIntent
+            }
+          }
+        ]
+      }
+    },
+    intent.app.Intent
+  )
+
+  builder.createDoc<Viewlet>(
+    view.class.Viewlet,
+    core.space.Model,
+    {
+      attachTo: intent.class.Intent,
+      descriptor: view.viewlet.Table,
+      config: ['', 'originator', 'state', 'modifiedOn'],
+      configOptions: {
+        sortable: true
+      }
+    },
+    intent.viewlet.TableIntent
+  )
+
+  builder.mixin(intent.class.Intent, core.class.Class, view.mixin.ObjectPanel, {
+    component: intent.component.EditIntentPanel
+  })
+
+  builder.mixin(intent.class.Intent, core.class.Class, view.mixin.ObjectPresenter, {
+    presenter: intent.component.IntentPresenter
+  })
+
+  builder.mixin(intent.class.Intent, core.class.Class, activity.mixin.ActivityDoc, {})
+  builder.mixin(intent.class.Contribution, core.class.Class, activity.mixin.ActivityDoc, {})
+
+  builder.createDoc(core.class.DomainIndexConfiguration, core.space.Model, {
+    domain: DOMAIN_INTENT,
+    disabled: [
+      { space: 1 },
+      { modifiedBy: 1 },
+      { createdBy: 1 },
+      { createdOn: -1 },
+      { attachedToClass: 1 }
+    ]
+  })
+}
