{
  "name": "celula-zero",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@celula-zero/web",
    "build": "npm run build --workspace=@celula-zero/web",
    "lint": "npm run lint --workspace=@celula-zero/web",
    "typecheck": "npm run typecheck --workspace=@celula-zero/web",
    "test": "npm run test --workspace=@celula-zero/web",
    "test:e2e": "npm run test:e2e --workspace=@celula-zero/web",
    "test:e2e:auth": "npm run test:e2e:auth --workspace=@celula-zero/web",
    "test:contracts": "node scripts/check-gate1-contracts.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:contracts && npm run build",
    "cz": "python3 scripts/cz-single-flight.py founder -- python3 scripts/cz-founder.py",
    "live": "python3 scripts/cz-single-flight.py living-presence -- python3 scripts/cz-living-presence.py",
    "worker:move2": "python3 scripts/cz-single-flight.py move2-worker -- node scripts/move2-vs1-worker.mjs",
    "room": "node scripts/cz-room.mjs",
    "room:export": "node scripts/cz-room.mjs --export",
    "room:handoff": "node scripts/cz-room.mjs --handoff",
    "exec:fabric": "node tools/cz-execution-fabric.mjs",
    "test:exec:fabric": "node --test tools/cz-execution-fabric.test.mjs",
    "test:room": "node --test scripts/cz-room.test.mjs",
    "test:room:participation-portability": "node --test scripts/cz-room-participation-portability.test.mjs",
    "test:interlock": "python3 scripts/test_cz_safe_local_db_operation.py"
  }
}
