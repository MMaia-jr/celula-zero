{
  "name": "celula-zero",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@celula-zero/web",
    "build": "npm run build --workspace=@celula-zero/web",
    "lint": "npm run lint --workspace=@celula-zero/web",
    "typecheck": "npm run typecheck --workspace=@celula-zero/web",
    "test": "npm run test --workspace=@celula-zero/web",
    "test:e2e": "npm run test:e2e --workspace=@celula-zero/web",
    "test:contracts": "node scripts/check-gate1-contracts.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:contracts && npm run build"
  }
}
